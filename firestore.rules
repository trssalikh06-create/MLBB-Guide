rules_version = '2';

service cloud.firestore {

    match /databases/{database}/documents {

        function signedIn() {
            return request.auth != null;
        }

        function owner(uid) {
            return signedIn()
                && request.auth.uid == uid;
        }

        function admin() {
            return signedIn()
                && get(
                    /databases/$(database)/documents/users/$(request.auth.uid)
                ).data.role == "admin";
        }

        match /users/{uid} {

            allow read: if owner(uid) || admin();

            allow create:
                if owner(uid)
                && request.resource.data.role == "user";

            allow update:
                if admin()
                || (
                    owner(uid)
                    && request.resource.data.role
                    == resource.data.role
                );

            allow delete: if admin();

            match /favorites/{heroId} {

                allow read, write:
                    if owner(uid) || admin();
            }

            match /history/{historyId} {

                allow read, write:
                    if owner(uid) || admin();
            }
        }

        match /heroes/{heroId} {

            allow read: if true;

            allow create, update, delete:
                if admin();

            match /builds/{buildId} {

                allow read: if true;

                allow create, update, delete:
                    if admin();
            }
        }

        match /items/{itemId} {

            allow read: if true;

            allow create, update, delete:
                if admin();
        }

        match /counters/{counterId} {

            allow read: if true;

            allow create, update, delete:
                if admin();
        }

        match /comments/{commentId} {

            allow read: if true;

            allow create:
                if signedIn()
                && request.resource.data.userId
                == request.auth.uid;

            allow update, delete:
                if admin()
                || (
                    signedIn()
                    && resource.data.userId
                    == request.auth.uid
                );
        }
    }
}